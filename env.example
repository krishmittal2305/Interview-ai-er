# AI Provider Configuration (groq or gemini)
AI_PROVIDER=groq

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Configuration (optional fallback)
GEMINI_API_KEY=your_gemini_api_key

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_SECRET_KEY=your_secret_key_here

# CORS Configuration
# Comma-separated list of allowed origins
# Include both your Vercel production URL and localhost for development
FRONTEND_URL=https://your-app.vercel.app,http://localhost:3000
